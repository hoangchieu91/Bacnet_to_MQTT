[Unit]
Description=BACnet-MQTT Gateway
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/bacnet_mqtt_gateway
Environment="PATH=/home/pi/bacnet_mqtt_gateway/venv/bin:/usr/bin:/bin"
ExecStart=/home/pi/bacnet_mqtt_gateway/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
