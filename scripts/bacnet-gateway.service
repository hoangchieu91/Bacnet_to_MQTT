[Unit]
Description=BACnet-MQTT Gateway
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/bacnet_mqtt_gateway
Environment="PATH=/home/user/bacnet_mqtt_gateway/venv/bin:/usr/bin:/bin"
ExecStart=/home/user/bacnet_mqtt_gateway/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
